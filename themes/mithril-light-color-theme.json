				"meta.brace",
				"keyword.operator"
			],
			"settings": {
				"foreground": "#3f6b72"
			}
		},
		{
			"scope": "entity.name.function",
			"settings": {
				"foreground": "#8250df"
			}
		},
		{
			"scope": [
				"entity.name.tag",
				"support.class.component"
			],
			"settings": {
				"foreground": "#a35f00"
			}
		},
		{
			"scope": "keyword",
			"settings": {
				"foreground": "#cf222e"
			}
		},
		{
			"scope": [
				"storage",
				"storage.type"
			],
			"settings": {
				"foreground": "#cf222e"
			}
		},
		{
			"scope": [
				"storage.modifier.package",
				"storage.modifier.import",
				"storage.type.java"
			],
			"settings": {
				"foreground": "#2a3134"
			}
		},
		{
			"scope": [
				"string",
